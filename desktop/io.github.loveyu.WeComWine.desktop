[Desktop Entry]
Type=Application
Name=企业微信（Wine Flatpak）
Comment=通过隔离的 Wine Flatpak 运行 Windows 企业微信
Exec=systemctl --user start wecom-flatpak-poc.target
Icon=io.github.loveyu.WeComWine
Terminal=false
Categories=Network;InstantMessaging;
StartupNotify=true
StartupWMClass=wxwork.exe
X-GNOME-UsesNotifications=true
